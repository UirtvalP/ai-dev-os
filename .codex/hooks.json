{
  "description": "AI Dev OS 确定性 Workspace 生命周期入口。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "ai-dev-os hook",
            "commandWindows": "ai-dev-os hook",
            "statusMessage": "自动恢复 AI Dev OS Workspace",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-dev-os hook",
            "commandWindows": "ai-dev-os hook",
            "statusMessage": "自动恢复 AI Dev OS Workspace",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-dev-os hook",
            "commandWindows": "ai-dev-os hook",
            "statusMessage": "检查已推送任务自动收尾",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-dev-os hook",
            "commandWindows": "ai-dev-os hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
